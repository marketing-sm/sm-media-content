<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Revenue OS ― 需要予測・インサイト提案・AI実装をひとつの基盤へ | Sales Marker</title>
<meta name="color-scheme" content="light">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0E1E45;
    --navy2:#16305E;
    --navy3:#1E3C74;
    --orange:#FF7A1A;
    --orange-soft:#FFE7D6;
    --mark:rgba(255,176,64,.55);
    --paper:#F5F6F9;
    --white:#FFFFFF;
    --ink:#16213F;
    --ink-soft:#5B6478;
    --line:#E1E4EA;
    --radius-s:6px;
    --radius-m:14px;
    --maxw:1180px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;background:var(--white);color:var(--ink);
    font-family:"Noto Sans JP","Hiragino Sans",sans-serif;
    line-height:1.8;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  }
  h1,h2,h3,h4{font-weight:900;letter-spacing:-0.01em;margin:0;color:var(--ink);}
  a{color:inherit;}
  img,svg{max-width:100%;display:block;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;}
  .mark{
    background-image:linear-gradient(var(--mark),var(--mark));
    background-repeat:no-repeat;background-size:100% 42%;background-position:0 86%;
    padding:0 2px;
  }
  section{padding:84px 0;}
  .bg-paper{background:var(--paper);}
  .sec-head{max-width:660px;margin:0 auto 48px;text-align:left;}
  .sec-head .kicker{color:var(--orange);font-weight:700;font-size:13.5px;margin-bottom:10px;display:block;}
  .sec-head h2{font-size:clamp(24px,3vw,34px);line-height:1.5;}
  .sec-head p{color:var(--ink-soft);margin-top:16px;font-size:15px;}

  /* ---------- HEADER ---------- */
  header.topbar{border-bottom:1px solid var(--line);background:var(--white);}
  .topbar-inner{max-width:var(--maxw);margin:0 auto;padding:16px 28px;display:flex;align-items:center;gap:16px;justify-content:space-between;}
  .brand{display:flex;align-items:center;gap:14px;}
  .brand-logo{height:26px;width:auto;display:block;}
  .brand .sep{width:1px;height:20px;background:var(--line);}
  .brand .page-label{font-size:14.5px;color:var(--ink-soft);white-space:nowrap;}
  .topbar-cta{
    background:var(--orange);color:#fff;padding:11px 20px;border-radius:999px;
    font-size:13.5px;font-weight:700;text-decoration:none;white-space:nowrap;
  }

  /* ---------- SUB NAV (numbered box tabs) ---------- */
  nav.subnav{position:sticky;top:0;z-index:40;background:var(--white);border-bottom:1px solid var(--line);}
  .subnav-inner{max-width:var(--maxw);margin:0 auto;padding:12px 28px;display:flex;gap:8px;overflow-x:auto;}
  .snbtn{
    flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:3px;
    padding:9px 16px;border-radius:8px;border:1px solid var(--line);background:var(--white);
    text-decoration:none;color:var(--ink-soft);min-width:104px;transition:.2s;
  }
  .snbtn .no{font-weight:900;font-size:12px;}
  .snbtn .lb{font-size:12px;font-weight:700;}
  .snbtn.active{background:var(--navy);border-color:var(--navy);color:#fff;}
  .snbtn:hover:not(.active){border-color:var(--navy);color:var(--ink);}

  /* ---------- HERO ---------- */
  .hero{background:linear-gradient(180deg,var(--navy) 0%, var(--navy2) 100%);color:#fff;padding:76px 0 64px;position:relative;overflow:hidden;}
  .hero::before{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(rgba(255,255,255,.10) 1px, transparent 1px);
    background-size:26px 26px;opacity:.5;pointer-events:none;
  }
  .hero-inner{position:relative;max-width:1040px;}
  .hero .kicker{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:#BFD0FF;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:8px 16px;margin-bottom:26px;}
  .hero h1{font-size:clamp(30px,4.4vw,48px);line-height:1.5;color:#fff;}
  .hero h1 .em{color:var(--orange);}
  .hero p.lead{color:#C7D1EA;margin:24px 0 0;font-size:16px;max-width:56ch;}
  .hero-ctas{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;}
  .btn-primary{background:var(--orange);color:#fff;padding:15px 28px;border-radius:var(--radius-s);font-weight:700;font-size:15px;text-decoration:none;border:none;cursor:pointer;box-shadow:0 10px 24px -10px rgba(255,122,26,.6);}
  .btn-ghost-dark{background:transparent;color:#fff;padding:15px 24px;border-radius:var(--radius-s);font-weight:700;font-size:15px;text-decoration:none;border:1px solid rgba(255,255,255,.35);}
  .hero-stats{display:flex;gap:0;margin-top:48px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.15);padding-top:28px;}
  .hero-stats div{flex:1 1 180px;border-left:1px solid rgba(255,255,255,.18);padding-left:18px;}
  .hero-stats div:first-child{border-left:none;padding-left:0;}
  .hero-stats .num{font-weight:900;font-size:24px;color:var(--orange);display:block;}
  .hero-stats .lbl{font-size:12.5px;color:#AAB6D4;margin-top:4px;}

  /* ---------- CALLOUT ---------- */
  .callout{
    border-left:4px solid var(--orange);background:var(--paper);border-radius:0 var(--radius-m) var(--radius-m) 0;
    padding:28px 30px;font-size:15px;color:var(--ink-soft);max-width:900px;margin:0 auto;
  }
  .callout b{color:var(--ink);font-weight:700;}

  /* ---------- PROBLEM CARDS ---------- */
  .problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:40px;}
  @media (max-width:860px){.problem-grid{grid-template-columns:1fr;}}
  .problem-card{border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;background:var(--white);}
  .problem-card .pc-top{padding:28px 24px 22px;}
  .problem-card .ic{width:38px;height:38px;border-radius:9px;background:var(--orange-soft);display:flex;align-items:center;justify-content:center;margin-bottom:16px;}
  .problem-card .ic svg{width:19px;height:19px;stroke:var(--orange);}
  .problem-card h3{font-size:16.5px;line-height:1.6;margin-bottom:10px;}
  .problem-card p{font-size:13.8px;color:var(--ink-soft);margin:0;}
  .problem-card .pc-foot{background:var(--navy);color:#fff;font-size:12.5px;font-weight:700;padding:12px 24px;}

  .evo-note{text-align:center;font-size:13.5px;color:var(--ink-soft);margin-top:30px;}
  .evo-note .step{color:var(--navy);font-weight:700;}
  .evo-note .step.now{color:var(--orange);}

  /* ---------- FLOW ---------- */
  .flow-diagram{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;}
  @media (max-width:860px){.flow-diagram{grid-template-columns:1fr;}}
  .flow-step{padding:32px 28px;background:var(--white);border-right:1px solid var(--line);}
  .flow-step:last-child{border-right:none;}
  @media (max-width:860px){.flow-step{border-right:none;border-bottom:1px solid var(--line);}}
  .flow-step .n{color:var(--orange);font-weight:900;font-size:12.5px;margin-bottom:14px;}
  .flow-step h3{font-size:18px;margin-bottom:8px;}
  .flow-step .prod{font-size:12.5px;color:var(--ink-soft);margin-bottom:12px;}
  .flow-step p{font-size:13.8px;color:var(--ink-soft);margin:0;}
  .loop-note{text-align:center;font-size:13.5px;color:var(--ink-soft);margin-top:20px;}

  /* ---------- SELF CHECK ---------- */
  .check-list{list-style:none;margin:36px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  @media (max-width:860px){.check-list{grid-template-columns:1fr;}}
  .check-list li{
    display:flex;gap:12px;background:var(--white);border:1px solid var(--line);border-radius:var(--radius-m);
    padding:20px 20px;font-size:14px;
  }
  .check-list .ck{flex:0 0 auto;width:20px;height:20px;border-radius:50%;background:var(--orange);display:flex;align-items:center;justify-content:center;margin-top:1px;}
  .check-list .ck svg{width:11px;height:11px;stroke:#fff;}

  /* ---------- SOLUTION SELECTOR ---------- */
  .sol-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  @media (max-width:1000px){.sol-row{grid-template-columns:1fr 1fr;}}
  @media (max-width:620px){.sol-row{grid-template-columns:1fr;}}
  .sol-card{
    position:relative;border-radius:var(--radius-m);padding:26px 22px;cursor:pointer;overflow:hidden;
    background:linear-gradient(160deg,var(--navy) 0%, var(--navy3) 100%);color:#fff;border:2px solid transparent;
    transition:transform .2s, border-color .2s;min-height:250px;display:flex;flex-direction:column;
  }
  .sol-card::before{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(rgba(255,255,255,.35) 1px, transparent 1px);
    background-size:22px 22px;opacity:.12;pointer-events:none;
  }
  .sol-card:hover{transform:translateY(-3px);}
  .sol-card.active{border-color:var(--orange);}
  .sol-card .kicker2{font-size:12px;color:#AFC0EA;margin-bottom:14px;position:relative;z-index:1;}
  .sol-card h3{font-size:19px;line-height:1.5;color:#fff;margin-bottom:10px;position:relative;z-index:1;}
  .sol-card p{font-size:13px;color:#C7D1EA;margin:0 0 auto;position:relative;z-index:1;}
  .sol-card .row-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:18px;position:relative;z-index:1;}
  .badge{font-size:11.5px;font-weight:700;padding:5px 11px;border-radius:999px;}
  .badge.viewing{border:1px solid rgba(255,255,255,.5);color:#fff;}
  .badge.avail{background:var(--orange);color:#fff;}
  .sol-link{font-size:13px;font-weight:700;color:var(--orange);text-decoration:none;}
  .sol-card.active .sol-link{color:#fff;}

  .sol-card.consult{background:linear-gradient(160deg,var(--orange) 0%, #FFA25A 100%);}
  .sol-card.consult .kicker2{color:#FFE3CC;}
  .sol-card.consult p{color:#FFEFE2;}
  .sol-card.consult .sol-link{color:#fff;}

  .swipe-hint{text-align:center;font-size:12.5px;color:var(--ink-soft);margin-top:16px;display:none;}
  @media (max-width:620px){.swipe-hint{display:block;}}

  /* ---------- DETAIL PANEL ---------- */
  .detail-panel{margin-top:52px;border:1px solid var(--line);border-radius:var(--radius-m);padding:44px;background:var(--white);}
  @media (max-width:640px){.detail-panel{padding:28px 22px;}}
  .detail-body{display:none;max-width:860px;margin:0 auto;}
  .detail-body.active{display:block;}
  .detail-body .solution-name{font-size:13px;color:var(--orange);font-weight:700;margin-bottom:12px;display:block;}
  .detail-body h3{font-size:24px;line-height:1.6;margin-bottom:18px;}
  .detail-body .desc{color:var(--ink-soft);font-size:15px;margin-bottom:26px;}
  .feature-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px;}
  .feature-list li{display:flex;gap:12px;font-size:14px;align-items:flex-start;}
  .feature-list .ck2{flex:0 0 auto;width:18px;height:18px;border-radius:50%;background:var(--orange-soft);display:flex;align-items:center;justify-content:center;margin-top:2px;}
  .feature-list .ck2 svg{width:10px;height:10px;stroke:var(--orange);}
  .feature-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px 22px;}
  @media (max-width:560px){.feature-grid-2{grid-template-columns:1fr;}}

  .process-steps{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;margin-bottom:26px;}
  .process-steps .p-step{display:flex;gap:14px;padding:16px 18px;border-bottom:1px solid var(--line);background:var(--white);}
  .process-steps .p-step:last-child{border-bottom:none;}
  .process-steps .p-step .p-no{flex:0 0 auto;width:24px;height:24px;border-radius:50%;background:var(--navy);color:#fff;font-size:11.5px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:1px;}
  .process-steps .p-title{font-weight:700;font-size:14px;margin-bottom:3px;}
  .process-steps .p-desc{font-size:12.8px;color:var(--ink-soft);}

  .info-callout{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius-m);padding:20px 22px;margin-bottom:26px;font-size:13.5px;color:var(--ink-soft);}
  .info-callout .ic-label{font-size:12px;font-weight:700;color:var(--orange);display:block;margin-bottom:10px;}
  .info-callout .sample{color:var(--ink);background:#fff;border:1px dashed var(--line);border-radius:8px;padding:12px 14px;margin-top:12px;font-size:13.3px;}
  .chip-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:2px;}
  .chip{font-size:11.8px;background:var(--orange-soft);color:var(--orange);padding:5px 11px;border-radius:999px;font-weight:700;white-space:nowrap;}

  .ba-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;margin-top:36px;}
  @media (max-width:820px){.ba-strip{grid-template-columns:1fr 1fr;}}
  .ba-cell{background:var(--white);padding:20px 16px;text-align:center;}
  .ba-cell .ba-label{font-size:12px;color:var(--ink-soft);margin-bottom:10px;}
  .ba-cell .ba-before{font-size:12.5px;color:#A8AEBD;text-decoration:line-through;}
  .ba-cell .ba-after{font-size:14px;color:var(--orange);font-weight:700;margin-top:4px;}

  .panel-media{border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;margin-bottom:22px;box-shadow:0 16px 32px -20px rgba(14,30,69,.28);background:var(--paper);}
  .panel-media img{width:100%;display:block;}
  .panel-media svg{width:100%;display:block;}
  .media-cap{font-size:12px;color:var(--ink-soft);text-align:center;margin:10px 0 26px;}
  .full-span{grid-column:1 / -1;}

  .device-frame{border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;box-shadow:0 20px 40px -22px rgba(14,30,69,.32);background:#fff;max-width:280px;margin:0 auto;}
  .device-frame .bar{display:flex;gap:6px;padding:11px 13px;background:#EEF0F4;border-bottom:1px solid var(--line);}
  .device-frame .bar span{width:8px;height:8px;border-radius:50%;background:#D3D6DE;}
  .device-frame img{width:100%;display:block;}
  .side-visual{margin-bottom:24px;}
  .side-visual .media-cap{margin:12px 0 0;}
  .step-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 24px;}
  .step-chips span{font-size:12.5px;color:var(--ink-soft);background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:6px 13px;}
  .step-chips .arrow{border:none;background:none;padding:0;color:var(--line);}
  .sol-card .card-ic{display:inline-block;width:30px;height:30px;margin-bottom:14px;position:relative;z-index:1;}
  .sol-card .card-ic svg{width:100%;height:100%;stroke:#fff;opacity:.9;}
  .tab-side{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius-m);padding:26px;}
  .tab-side .kpi-row{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);}
  .tab-side .kpi-row:last-of-type{border-bottom:none;}
  .tab-side .kpi-row .l{font-size:13px;color:var(--ink-soft);}
  .tab-side .kpi-row .v{font-weight:900;font-size:14px;text-align:right;}
  .tab-side .mini-cta{display:block;text-align:center;margin-top:22px;background:var(--navy);color:#fff;padding:14px;border-radius:var(--radius-s);text-decoration:none;font-weight:700;font-size:14px;}

  /* ---------- PROOF ---------- */
  .proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;}
  @media (max-width:780px){.proof-grid{grid-template-columns:1fr;}}
  .proof-cell{background:var(--white);padding:36px 28px;text-align:center;}
  .proof-cell .num{font-weight:900;font-size:34px;color:var(--orange);}
  .proof-cell .lbl{font-size:13px;color:var(--ink-soft);margin-top:8px;}
  .proof-note{font-size:11.5px;color:var(--ink-soft);margin-top:16px;text-align:center;}

  .case-strip{margin-top:48px;border-radius:var(--radius-m);padding:30px 32px;display:flex;gap:26px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:var(--navy);color:#fff;}
  .case-strip .case-text{max-width:560px;}
  .case-strip .case-text .co{font-weight:700;font-size:13px;color:var(--orange);margin-bottom:8px;display:block;}
  .case-strip .case-text h4{font-size:17px;font-weight:700;margin:0 0 6px;color:#fff;}
  .case-strip .case-text p{margin:0;font-size:13.5px;color:#C7D1EA;}
  .case-strip a.arrow-link{font-weight:700;font-size:14px;text-decoration:none;white-space:nowrap;color:#fff;background:rgba(255,255,255,.12);padding:11px 18px;border-radius:8px;border:1px solid rgba(255,255,255,.3);}

  /* ---------- QUOTE ---------- */
  .quote-block{max-width:820px;margin:0 auto;text-align:left;}
  .quote-block .qmark{font-size:60px;color:var(--orange-soft);font-weight:900;line-height:.4;margin-bottom:6px;}
  .quote-block p{font-size:16px;color:var(--ink);margin:0 0 14px;}
  .quote-block .attrib{font-size:13.5px;color:var(--ink-soft);margin-top:20px;}
  .quote-block .attrib b{color:var(--ink);}

  /* ---------- CTA / FORM ---------- */
  .cta-section{background:var(--navy);color:#fff;}
  .cta-section .sec-head h2{color:#fff;}
  .cta-section .sec-head p{color:#B7C1DE;}
  .cta-section .sec-head .kicker{color:var(--orange);}
  .cta-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;}
  @media (max-width:900px){.cta-grid{grid-template-columns:1fr;}}
  .cta-grid h2{color:#fff;}
  .cta-points{list-style:none;padding:0;margin:26px 0 0;display:flex;flex-direction:column;gap:14px;}
  .cta-points li{display:flex;gap:12px;font-size:14px;color:#C7D1EA;}
  .cta-points .dot2{flex:0 0 auto;width:6px;height:6px;border-radius:50%;background:var(--orange);margin-top:9px;}

  form.lead-form{background:#132348;border:1px solid #2A3D66;border-radius:var(--radius-m);padding:30px;}
  .field{margin-bottom:16px;}
  .field label{display:block;font-size:12.5px;color:#AFC0E0;margin-bottom:7px;}
  .field input,.field select,.field textarea{width:100%;background:#0F1C3B;border:1px solid #2A3D66;border-radius:6px;padding:11px 13px;color:#fff;font-family:inherit;font-size:14px;}
  .field input:focus,.field select:focus,.field textarea:focus{outline:2px solid var(--orange);outline-offset:1px;}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media (max-width:520px){.field-row{grid-template-columns:1fr;}}
  .submit-btn{width:100%;background:var(--orange);color:#fff;border:none;padding:15px;border-radius:6px;font-weight:700;font-size:15px;cursor:pointer;margin-top:4px;}
  .form-note{font-size:11.5px;color:#8593B5;margin-top:12px;text-align:center;}
  .success-msg{display:none;text-align:center;padding:36px 8px;}
  .success-msg.show{display:block;}
  .success-msg .mark2{width:48px;height:48px;border-radius:50%;background:rgba(255,122,26,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
  .success-msg h4{color:#fff;font-size:18px;margin-bottom:8px;}
  .success-msg p{color:#B7C1DE;font-size:13.5px;}

  /* ---------- FOOTER ---------- */
  footer{padding:48px 0 36px;border-top:1px solid var(--line);background:var(--paper);}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px;margin-bottom:34px;}
  @media (max-width:780px){.footer-grid{grid-template-columns:1fr;}}
  .footer-grid h5{font-size:12.5px;color:var(--ink-soft);font-weight:700;margin-bottom:14px;}
  .footer-grid p, .footer-grid a{font-size:13px;color:var(--ink-soft);line-height:2;text-decoration:none;display:block;}
  .footer-grid .company-name{font-weight:700;color:var(--ink);margin-bottom:6px;}
  .footer-bottom{border-top:1px solid var(--line);padding-top:22px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--ink-soft);}
</style>
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <img class="brand-logo" src="data:image/png;base64," alt="Sales Marker">
      <span class="sep"></span>
      <span class="page-label">Revenue OS</span>
    </div>
    <a class="topbar-cta" href="https://sales-marker.jp/demo/" target="_blank" rel="noopener">デモを予約する</a>
  </div>
</header>

<nav class="subnav">
