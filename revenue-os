<script>
  // Solution selector + detail panel
  const solCards = document.querySelectorAll('.sol-card[data-tab]');
  const detailBodies = document.querySelectorAll('.detail-body');
  solCards.forEach(card=>{
    card.addEventListener('click', ()=>{
      solCards.forEach(c=>{
        c.classList.remove('active');
        const b = c.querySelector('[data-badge]');
        const l = c.querySelector('[data-link]');
        if(b){ b.textContent='提供中'; b.classList.remove('viewing'); b.classList.add('avail'); }
        if(l){ l.textContent='コンテンツを見る →'; }
      });
      card.classList.add('active');
      const b = card.querySelector('[data-badge]');
      const l = card.querySelector('[data-link]');
      if(b){ b.textContent='閲覧中'; b.classList.remove('avail'); b.classList.add('viewing'); }
      if(l){ l.textContent='詳細を見る'; }

      detailBodies.forEach(p=>p.classList.remove('active'));
      document.getElementById(card.dataset.tab).classList.add('active');
      document.querySelector('.detail-panel').scrollIntoView({behavior:'smooth', block:'nearest'});
    });
  });

  // Sub-nav scroll spy
  const snBtns = document.querySelectorAll('.snbtn');
  const targets = Array.from(snBtns).map(b=>document.getElementById(b.dataset.target)).filter(Boolean);

  let suppressSpy = false;
  let suppressTimer = null;

  function setActiveButton(btn){
    snBtns.forEach(b=>b.classList.remove('active'));
    if(btn) btn.classList.add('active');
  }

  snBtns.forEach(btn=>{
    btn.addEventListener('click', ()=>{
      setActiveButton(btn);
      suppressSpy = true;
      clearTimeout(suppressTimer);
      suppressTimer = setTimeout(()=>{ suppressSpy = false; }, 900);
    });
  });

  const io = new IntersectionObserver((entries)=>{
    if(suppressSpy) return;
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        const match = document.querySelector('.snbtn[data-target="'+entry.target.id+'"]');
        setActiveButton(match);
      }
    });
  }, {rootMargin:'-40% 0px -55% 0px'});
  targets.forEach(t=>io.observe(t));
</script>
    

